# =============================================================================
# API Keys - NEVER commit this file with real keys. Copy to .env and fill in.
# .env is gitignored. Use these placeholders only.
# =============================================================================

# --- Shadow Council LLM (first available is used) ---
# Groq (default): FREE tier, Llama 3.3 70B, 500 RPM. Get key: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_key_here

# Fallbacks (optional)
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=sk-your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Voice (ElevenLabs TTS for Chief of Staff) ---
ELEVENLABS_API_KEY=your_elevenlabs_key_here
